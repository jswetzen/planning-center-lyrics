# ---------------------------------------------------------------------------
# Planning Center Services API credentials
# ---------------------------------------------------------------------------
# Create a Personal Access Token at:
#   https://api.planningcenteronline.com/oauth/applications
# -> "New Personal Access Token"
# This gives you an Application ID (username) and a Secret (password) used
# for HTTP Basic Auth against the Planning Center API. See README.md for
# step-by-step instructions.
PLANNING_CENTER_APP_ID=
PLANNING_CENTER_SECRET=

# Optional: pin the script to a specific Service Type (e.g. "Sunday Service").
# Find this by running the script with --list-service-types.
# If left blank, the script searches across all service types for the
# nearest upcoming plan.
PLANNING_CENTER_SERVICE_TYPE_ID=

# ---------------------------------------------------------------------------
# Output formatting
# ---------------------------------------------------------------------------
# Used as the prefix for the generated page title, e.g. "Lovsång Brokyrkan - 2024-08-04"
PAGE_TITLE_PREFIX=Lovsång Brokyrkan

# ---------------------------------------------------------------------------
# Admin UI (admin_app.py / containerized deployment only)
# ---------------------------------------------------------------------------
# HTTP Basic Auth credentials gating the admin UI (regenerate/open/close
# buttons). ADMIN_PASSWORD is required -- admin_app.py refuses to start
# without one, since this UI controls whether copyrighted lyrics are
# publicly served. Basic Auth itself isn't encrypted, so still put this
# behind TLS (a reverse proxy) rather than exposing it directly.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Scheduler (admin_app.py / containerized deployment only)
# ---------------------------------------------------------------------------
# How often (in seconds) the background scheduler re-checks configured
# automation rules (see the "Manage rules" screen in the admin UI).
SCHEDULER_POLL_SECONDS=300

# IANA timezone used to compute "today" and to sanity-check each plan's
# scheduled time -- Planning Center's API returns UTC timestamps, so this
# needs to be the church's local timezone, not the server's.
SCHEDULER_TIMEZONE=Europe/Stockholm
